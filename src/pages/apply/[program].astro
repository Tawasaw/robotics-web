---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { programs } from "../../data/programs";

export function getStaticPaths() {
  return programs.map((program) => ({
    params: { program: program.key },
    props: { program }
  }));
}

const { program } = Astro.props;
const accent = program.key === "ftc";
---

<Base
  title={`Apply for ${program.shortName} | Tawasaw Robotics`}
  description={`${program.name} — ${program.ages} at Tawasaw Silicon Valley. ${program.description}`}
>
  <main>
    <div class="subnav">
      <div class="shell subnav__inner">
        <a class="btn btn--quiet" href="/">
          <Icon name="arrow-left" size={18} />
          View both programs
        </a>
        <p class="subnav__season">2026–2027 Season</p>
      </div>
    </div>

    <section class="section section--muted">
      <div class="apply">
        <div class:list={["apply__side", accent && "apply__side--accent"]}>
          <div class="program__top">
            <span class="pill">{program.ages}</span>
            <span class="program__glyph">
              <Icon name={program.icon} size={44} />
            </span>
          </div>
          <p class="program__short">{program.shortName}</p>
          <h1 class="program__name">{program.name}</h1>
          <p class="apply__desc">
            {program.description}
          </p>
          <ul class="checklist">
            {program.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>

        <div class="apply__form">
          <p class="eyebrow">Registration</p>
          <h2>Apply for {program.shortName}</h2>
          <p class="apply__note">
            The registration form for this program will be added here. Please check
            back soon or contact us for enrollment questions.
          </p>

          <div class="apply__when">
            <Icon name="clock" size={32} />
            <div>
              <h3>Saturdays at {program.meetingTime}</h3>
              <p>Sessions begin September 2026.</p>
            </div>
          </div>

          <div class="apply__actions">
            <a class="btn" href="mailto:robotics-outreach@tawasaw.org">
              Contact us
              <Icon name="mail" size={18} />
            </a>
            {
              program.key === "ftc" && (
                <>
                  <a class="btn btn--invert" href="/ftc30619/">
                    Mars Rovers website
                    <Icon name="arrow-right" size={18} />
                  </a>
                  <a
                    class="btn btn--invert"
                    href="https://eclipse30618.com"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Eclipse website
                    <Icon name="arrow-right" size={18} />
                  </a>
                  <span class="btn btn--invert btn--disabled" aria-disabled="true">
                    Supernova website — coming soon
                  </span>
                </>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
