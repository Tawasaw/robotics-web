---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Connect from "../components/Connect.astro";
import { programs } from "../data/programs";

const values = [
  { icon: "users" as const, title: "Teamwork", copy: "Build lasting friendships" },
  {
    icon: "wrench" as const,
    title: "Skills",
    copy: "Engineering, coding, critical thinking"
  },
  {
    icon: "trophy" as const,
    title: "Competition",
    copy: "Compete at local, state, national & international tournaments"
  },
  {
    icon: "heart" as const,
    title: "Character",
    copy: "Leadership, confidence, service"
  },
  {
    icon: "sparkles" as const,
    title: "Tarbiyah",
    copy: "Strengthen faith. Make an impact."
  }
];
---

<Base title="Tawasaw Silicon Valley">
  <main id="top">
    <section class="section">
      <div class="hero">
        <div class="hero__copy">
          <h1 class="hero__title">Tawasaw Robotics Programs</h1>
          <p class="hero__tagline">
            Building robots.<br /><span>Building futures.</span>
          </p>
          <p class="hero__deck">
            Excel in Deen through Tarbiyah.<br />
            Excel in Dunyah through Robotics.
          </p>
          <p class="hero__season">2026–2027 Season</p>
        </div>
        <div class="hero__art">
          <img
            src="/islamic-robot-1446.webp"
            srcset="/islamic-robot-720.webp 720w, /islamic-robot-1446.webp 1446w"
            sizes="(min-width: 1024px) 50vw, 100vw"
            alt="Islamic-crafted wooden robot — uniting faith and science"
            width="1446"
            height="1087"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section id="programs" class="section section--muted">
      <div class="shell section__inner">
        <div class="section-head">
          <div>
            <p class="eyebrow">Choose a program</p>
            <h2>Two programs. One mission.</h2>
          </div>
          <p class="lede">
            Hands-on robotics grounded in teamwork, Tarbiyah, and meaningful
            competition.
          </p>
        </div>

        <div class="programs">
          {
            programs.map((program, index) => (
              <article class:list={["program", index > 0 && "program--accent"]}>
                <div class="program__top">
                  <span class="pill">{program.ages}</span>
                  <span class="program__glyph">
                    <Icon name={program.icon} size={44} />
                  </span>
                </div>
                <p class="program__short">{program.shortName}</p>
                <h3 class="program__name">{program.name}</h3>
                <ul class="checklist">
                  {program.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <a
                  class:list={["btn", "btn--block", index > 0 && "btn--invert"]}
                  href={`/apply/${program.key}/`}
                >
                  Apply for {program.shortName}
                  <Icon name="arrow-right" size={18} />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell section__inner">
        <h2 class="section-title">More than robots</h2>
        <div class="values">
          {
            values.map(({ icon, title, copy }) => (
              <article class="value">
                <Icon name={icon} size={40} />
                <h3>{title}</h3>
                <p>{copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="schedule" class="section--primary">
      <div class="schedule">
        <div class="schedule__cell schedule__cell--icon">
          <Icon name="clock" size={48} />
          <div>
            <p class="schedule__label">Saturdays</p>
            <div class="schedule__times">
              {
                programs.map((program) => (
                  <p>
                    <span>{program.shortName}</span> {program.meetingTime}
                  </p>
                ))
              }
            </div>
          </div>
        </div>
        <div class="schedule__cell">
          <p class="schedule__label">Starting</p>
          <p class="schedule__value">Sept. 2026</p>
        </div>
      </div>
    </section>

    <section id="dashboard" class="section section--top-rule">
      <div class="shell section__inner">
        <div class="section-head">
          <div>
            <p class="eyebrow">For enrolled families and coaches</p>
            <h2>Tawasaw Robotics Dashboard</h2>
          </div>
          <p class="lede">
            Once a student has a place on a team, the season is run through our
            own application at <strong>robotics.tawasaw.com</strong> — a
            separate, sign-in-only site from this public one.
          </p>
        </div>

        <div class="policy">
          <p>
            The Dashboard is how our program keeps a season organized. It exists so
            that a parent, a coach, and an administrator are each looking at the
            same roster, the same signatures, and the same attendance record.
          </p>
          <ul class="checklist">
            <li>
              Parents and guardians read and sign the season's program
              agreements for their own students, and can re-read anything they
              have signed.
            </li>
            <li>
              Coaches open and close Saturday meetings, take attendance, and
              keep their team roster current.
            </li>
            <li>
              Families follow a student's application through review, and see
              that student's attendance for the season.
            </li>
            <li>
              Administrators manage seasons, teams, and enrollment, and answer
              requests to delete a family's records.
            </li>
          </ul>

          <p>
            You sign in with Google, or with a one-time link sent to your email
            address. Signing in with Google tells the Dashboard only your name,
            email address, and profile picture — it asks for nothing else, and
            it can neither read nor send your mail.
          </p>
          <p>
            <strong>There is no public sign-up.</strong> An account exists only
            for someone an administrator has already added to the program, and
            it is matched to the email address we hold for you. That is
            deliberate: this is a program for children, and an open sign-up
            would put strangers inside the family roster. If you try to sign in
            before you have been added, the Dashboard will turn you away rather
            than create an account.
          </p>
          <p>
            What the Dashboard collects and how long it is kept is described in our
            <a href="/privacy/">Privacy Policy</a>.
          </p>

          <a class="btn" href="https://robotics.tawasaw.com/">
            Go to the Dashboard
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section section--top-rule">
      <div class="shell callout">
        <Icon name="award" size={40} />
        <h2>2025–2026 Season Achievements</h2>
        <a class="btn" href="/achievements/">
          View season achievements
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </section>

    <Connect />
  </main>
</Base>
