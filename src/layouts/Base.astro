---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Tawasaw Silicon Valley robotics programs for ages 9–18, combining FLL and FTC competition with Tarbiyah-based leadership."
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tawasaw" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/islamic-robot-og.jpg", Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="902" />
    <meta
      property="og:image:alt"
      content="An Islamic-art-inspired wooden competition robot"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/islamic-robot-og.jpg", Astro.site)}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Audiowide&family=Rajdhani:wght@400;500;600;700&display=swap"
    />

    <slot name="head" />
  </head>
  <body>
    <header class="masthead">
      <div class="shell masthead__inner">
        <a href="/" class="masthead__logo" aria-label="Tawasaw Robotics home">
          <img
            src="/tawasaw-robotics-white.png"
            alt="Tawasaw Robotics — Silicon Valley"
            width="614"
            height="332"
          />
        </a>
        <a
          href="https://www.tawasaw.org/"
          class="masthead__link"
          aria-label="Tawasaw Institute website"
        >
          <img
            src="/tawasaw-institute-white.png"
            alt="Tawasaw Institute"
            width="1500"
            height="523"
          />
        </a>
      </div>
    </header>
    <slot />
  </body>
</html>
